{
  "name": {
    "en": "Flexit Nordic"
  },
  "class": "fan",
  "capabilities": [
    "flexit_mode",
    "target_temperature",
    "measure_temperature",
    "measure_temperature.outside",
    "measure_temperature.extract",
    "measure_temperature.exhaust",
    "measure_humidity",
    "fan_speed_supply",
    "fan_speed_exhaust",
    "fan_rpm_supply",
    "fan_rpm_exhaust",
    "heat_exchanger_efficiency",
    "heat_exchanger_speed",
    "measure_power",
    "electric_heater",
    "alarm_filter"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "title": { "en": "Temperature Setpoint" },
      "min": 14,
      "max": 30,
      "step": 0.5
    },
    "measure_temperature": {
      "title": { "en": "Supply Temperature" }
    },
    "measure_temperature.outside": {
      "title": { "en": "Outside Temperature" }
    },
    "measure_temperature.extract": {
      "title": { "en": "Extract Temperature" }
    },
    "measure_temperature.exhaust": {
      "title": { "en": "Exhaust Temperature" }
    },
    "measure_power": {
      "title": { "en": "Heater Power" },
      "decimals": 0
    }
  },
  "platforms": ["local"],
  "connectivity": ["lan"],
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": { "next": "add_devices" }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": { "en": "Connection" },
      "children": [
        {
          "id": "ip_address",
          "type": "text",
          "label": { "en": "IP Address" },
          "value": ""
        },
        {
          "id": "device_id",
          "type": "number",
          "label": { "en": "BACnet Device ID" },
          "value": 2,
          "min": 0,
          "max": 4194303
        },
        {
          "id": "poll_interval",
          "type": "number",
          "label": { "en": "Poll Interval (seconds)" },
          "value": 30,
          "min": 5,
          "max": 3600
        }
      ]
    }
  ]
}
